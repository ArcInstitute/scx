TARGET_DIR = $(CURDIR)/rust_target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/librscx.a
PKG_LIBS = -L$(LIBDIR) -Wl,--whole-archive -lrscx -Wl,--no-whole-archive

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

# N.B.: Cargo.toml is in the package root (one level up from src/).
# The crate depends on sibling workspace crates (scx-format, scx-codec, etc.)
# via path dependencies that resolve relative to Cargo.toml.
$(STATLIB):
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	RUSTFLAGS="$(RUSTFLAGS)" cargo build --lib --release \
		--manifest-path=../Cargo.toml \
		--target-dir $(TARGET_DIR)

rust_clean: $(SHLIB)
	rm -Rf $(TARGET_DIR)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR)
