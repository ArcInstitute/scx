# SCX benchmark environment configuration
# Copy this file to .env and set the paths for your environment.

# SCX_WORK_DIR: base working directory for benchmark data and artifacts (required)
SCX_WORK_DIR=/path/to/your/scx/workdir

# SCX_DATA_DIR: directory containing benchmark datasets
# Defaults to SCX_WORK_DIR/benchmarks/datasets if not set.
# SCX_DATA_DIR=/path/to/your/scx/datasets
