# SCX benchmark environment configuration
# Copy this file to .env and set the paths for your environment.

# SCX_WORK_DIR: base working directory for benchmark data and artifacts (required)
SCX_WORK_DIR=/path/to/your/scx/workdir

# SCX_DATA_DIR: directory containing benchmark datasets
# Defaults to SCX_WORK_DIR/benchmarks/datasets if not set.
# SCX_DATA_DIR=/path/to/your/scx/datasets

# GOOGLE_APPLICATION_CREDENTIALS: path to the GCP service-account JSON key
# used by the cloud benchmarks (cloud_push / cloud_pull / cloud_read / …).
# Tildes are expanded. Leave commented until you've minted a key — see
# docs/cloud.md → "Benchmark service-account bootstrap (one-time)" for the
# gcloud commands. The harness auto-loads this file via python-dotenv, so a
# shell `export` is not required once the line below is uncommented.
# GOOGLE_APPLICATION_CREDENTIALS=~/.gcp/scx-bench.json
