# Misc
CLAUDE.local.md

# Root scratch planning / review docs. AGENTS.md already forbids committing
# these and forbids tracked files citing them, but there was no pattern here,
# so they sat untracked — and `git status --porcelain` is what
# `capture_baseline.capture_environment` reads for `git_dirty`, which stamps
# every captured baseline "will not be reproducible" over three files that are
# not part of the build. Anchored to the repo root so a legitimately tracked
# doc deeper in the tree is unaffected.
/2026-*_CODE-REVIEW*.md
/2026-*_REGRESSIONS*.md
/*_CODE-REVIEW.md
/Phase*.md
.nfs*
archive/
tasks/
tmp/
learn/
.antigravitycli/
.claude/*.lock
data/*.h5ad
pyscx/data/*.h5ad
*.proptest-regressions
external-repos/
benchmarks/logs/
benchmarks/comprehensive/results/raw/
benchmarks/comprehensive/results/*/raw/
benchmarks/comprehensive/results/*/fingerprints/arrays/
benchmarks/comprehensive/results/raw_archive_*/
benchmarks/comprehensive/results/reports/figures/
benchmarks/comprehensive/results/reports_archive_*/
benchmarks/comprehensive/logs/
benchmarks/comprehensive/results/baseline_*/
benchmarks/comprehensive/results/candidate_*/
benchmarks/comprehensive/results/accel_smoke_*/
benchmarks/comprehensive/results/tier*/
benchmarks/comprehensive/results/g4*/
benchmarks/comprehensive/results/v*soak_*/
benchmarks/comprehensive/results/v3on2_*/
benchmarks/comprehensive/results/v*/
benchmarks/comprehensive/results/opt*/
benchmarks/comprehensive/results/phase*/
benchmarks/scripts/phase*_*
# Two one-off gate/verification wrappers kept on disk but not tracked. Named
# individually on purpose: 27 of the 31 `benchmarks/scripts/_run_*.sh` ARE
# tracked, so a blanket `_run_*.sh` pattern would silently hide future wrappers
# that the repo's own convention says to commit (e.g. _run_phase7_gate.sh,
# _run_4_2_gpu_staging_only.sh). Ignoring by name keeps that signal intact.
benchmarks/scripts/_run_gpu_runtime_fallback_check.sh
benchmarks/scripts/_run_phase6_gate.sh
benchmarks/scripts/g4*
# Benchmark run logs (regenerable SLURM/orchestrator output; keep the scripts)
benchmarks/scripts/*.log

build_artifacts/
LINT_WARNINGS.json
dashboard_history.json

# Generated report artifacts — regenerable via write_report() / write_landing()
# from results/raw/ or a promoted baseline snapshot. Publish via
# DASHBOARD_PUBLISH_TARGET + publish_dashboard.py rather than committing, to
# avoid blob churn (PDF is ~1 MB and rewrites on every run).
benchmarks/comprehensive/results/reports/BENCHMARK_REPORT.*
benchmarks/comprehensive/results/reports/index.*
# dashboard_history.json accumulates per-snapshot URLs for "← previous
# snapshot" navigation. Local to each operator; the publish target keeps
# its own canonical history.
benchmarks/comprehensive/results/reports/dashboard_history.json
# Hand-curated per-phase reports (phase3_report.md, phase5A_ooc_rss.*)
# stay tracked — they're explicit deliverables, not regenerated per run.
.claude/*.lock

# Rust
/target/
